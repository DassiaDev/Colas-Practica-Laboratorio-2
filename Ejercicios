"""
Caso práctico: Sistema de gestión de órdenes de servicio de un centro de atención.

Se implementan tres estructuras de datos básicas desde cero (sin usar list de
Python como contenedor principal):
    - Lista simplemente ligada
    - Lista doblemente ligada
    - Lista circular (simple y doble)

y 10 ejercicios que las utilizan junto con algoritmos de ordenamiento
(inserción, burbuja, selección) y búsqueda (lineal y binaria).
"""

from dataclasses import dataclass

PRUEBAS_OK = 0


def verificar(condicion, mensaje):
    """Aserción con contador, para el reporte de pruebas."""
    global PRUEBAS_OK
    assert condicion, f"FALLÓ: {mensaje}"
    PRUEBAS_OK += 1
    print(f"   [OK] {mensaje}")


def titulo(texto):
    print("\n" + "=" * 70)
    print(texto)
    print("=" * 70)


@dataclass
class Orden:
    """Orden de servicio. prioridad: 1 = alta, 2 = media, 3 = baja."""
    folio: int
    cliente: str
    servicio: str
    prioridad: int = 2

    def __str__(self):
        return f"#{self.folio} {self.cliente} - {self.servicio} (P{self.prioridad})"


# ======================================================================
# 1) LISTA SIMPLEMENTE LIGADA
# ======================================================================
class NodoS:
    def __init__(self, dato):
        self.dato = dato
        self.sig = None


class ListaSimple:
    def __init__(self):
        self.cabeza = None
        self.tam = 0

    def __len__(self):
        return self.tam

    def __iter__(self):
        actual = self.cabeza
        while actual:
            yield actual.dato
            actual = actual.sig

    def insertar_inicio(self, dato):          # O(1)
        nuevo = NodoS(dato)
        nuevo.sig = self.cabeza
        self.cabeza = nuevo
        self.tam += 1

    def insertar_final(self, dato):           # O(n)
        nuevo = NodoS(dato)
        if not self.cabeza:
            self.cabeza = nuevo
        else:
            actual = self.cabeza
            while actual.sig:
                actual = actual.sig
            actual.sig = nuevo
        self.tam += 1

    def buscar(self, folio):                  # búsqueda lineal O(n)
        comparaciones = 0
        actual = self.cabeza
        while actual:
            comparaciones += 1
            if actual.dato.folio == folio:
                return actual.dato, comparaciones
            actual = actual.sig
        return None, comparaciones

    def eliminar(self, folio):                # O(n)
        previo, actual = None, self.cabeza
        while actual:
            if actual.dato.folio == folio:
                if previo:
                    previo.sig = actual.sig
                else:
                    self.cabeza = actual.sig
                self.tam -= 1
                return actual.dato
            previo, actual = actual, actual.sig
        return None

    def invertir(self):                       # O(n)
        previo, actual = None, self.cabeza
        while actual:
            siguiente = actual.sig
            actual.sig = previo
            previo, actual = actual, siguiente
        self.cabeza = previo

    def ordenar_insercion(self):              # Inserción: O(n^2) peor caso
        """Ordena por (prioridad, folio) reenlazando nodos."""
        ordenada = None
        actual = self.cabeza
        while actual:
            siguiente = actual.sig
            clave = (actual.dato.prioridad, actual.dato.folio)
            if ordenada is None or clave < (ordenada.dato.prioridad, ordenada.dato.folio):
                actual.sig = ordenada
                ordenada = actual
            else:
                p = ordenada
                while p.sig and (p.sig.dato.prioridad, p.sig.dato.folio) <= clave:
                    p = p.sig
                actual.sig = p.sig
                p.sig = actual
            actual = siguiente
        self.cabeza = ordenada

    def a_arreglo(self):
        return list(self)

    @staticmethod
    def fusionar_ordenadas(a, b):             # O(n + m)
        """Mezcla dos listas ya ordenadas por (prioridad, folio)."""
        resultado = ListaSimple()
        x, y = a.cabeza, b.cabeza
        cola = None

        def clave(n):
            return (n.dato.prioridad, n.dato.folio)

        while x or y:
            if y is None or (x is not None and clave(x) <= clave(y)):
                tomado, x = x, x.sig
            else:
                tomado, y = y, y.sig
            nuevo = NodoS(tomado.dato)
            if cola is None:
                resultado.cabeza = nuevo
            else:
                cola.sig = nuevo
            cola = nuevo
            resultado.tam += 1
        return resultado


# ======================================================================
# 2) LISTA DOBLEMENTE LIGADA
# ======================================================================
class NodoD:
    def __init__(self, dato):
        self.dato = dato
        self.sig = None
        self.ant = None


class ListaDoble:
    def __init__(self):
        self.cabeza = None
        self.cola = None
        self.tam = 0

    def __len__(self):
        return self.tam

    def __iter__(self):
        actual = self.cabeza
        while actual:
            yield actual.dato
            actual = actual.sig

    def recorrer_inverso(self):
        actual = self.cola
        while actual:
            yield actual.dato
            actual = actual.ant

    def insertar_inicio(self, dato):          # O(1)
        nuevo = NodoD(dato)
        if self.cabeza is None:
            self.cabeza = self.cola = nuevo
        else:
            nuevo.sig = self.cabeza
            self.cabeza.ant = nuevo
            self.cabeza = nuevo
        self.tam += 1

    def insertar_final(self, dato):           # O(1) gracias al puntero cola
        nuevo = NodoD(dato)
        if self.cola is None:
            self.cabeza = self.cola = nuevo
        else:
            nuevo.ant = self.cola
            self.cola.sig = nuevo
            self.cola = nuevo
        self.tam += 1

    def _nodo_en(self, pos):
        if pos < 0 or pos >= self.tam:
            raise IndexError("posición fuera de rango")
        if pos <= self.tam // 2:
            actual = self.cabeza
            for _ in range(pos):
                actual = actual.sig
        else:
            actual = self.cola
            for _ in range(self.tam - 1 - pos):
                actual = actual.ant
        return actual

    def insertar_en(self, pos, dato):         # O(n)
        if pos == 0:
            return self.insertar_inicio(dato)
        if pos == self.tam:
            return self.insertar_final(dato)
        derecho = self._nodo_en(pos)
        nuevo = NodoD(dato)
        izquierdo = derecho.ant
        nuevo.ant, nuevo.sig = izquierdo, derecho
        izquierdo.sig = nuevo
        derecho.ant = nuevo
        self.tam += 1

    def eliminar_en(self, pos):               # O(n)
        nodo = self._nodo_en(pos)
        if nodo.ant:
            nodo.ant.sig = nodo.sig
        else:
            self.cabeza = nodo.sig
        if nodo.sig:
            nodo.sig.ant = nodo.ant
        else:
            self.cola = nodo.ant
        self.tam -= 1
        return nodo.dato

    def ordenar_burbuja(self):                # Burbuja: O(n^2), O(n) si ya está ordenada
        if self.tam < 2:
            return 0
        intercambios = 0
        hubo_cambio = True
        limite = None
        while hubo_cambio:
            hubo_cambio = False
            actual = self.cabeza
            while actual.sig is not limite:
                a, b = actual.dato, actual.sig.dato
                if (a.prioridad, a.folio) > (b.prioridad, b.folio):
                    actual.dato, actual.sig.dato = b, a
                    intercambios += 1
                    hubo_cambio = True
                actual = actual.sig
            limite = actual
        return intercambios


# ======================================================================
# 3) LISTA CIRCULAR SIMPLE (guarda el puntero al ÚLTIMO nodo)
# ======================================================================
class ListaCircular:
    def __init__(self):
        self.ultimo = None
        self.tam = 0

    def __len__(self):
        return self.tam

    def __iter__(self):
        if self.ultimo is None:
            return
        actual = self.ultimo.sig
        for _ in range(self.tam):
            yield actual.dato
            actual = actual.sig

    def insertar_final(self, dato):           # O(1)
        nuevo = NodoS(dato)
        if self.ultimo is None:
            nuevo.sig = nuevo
        else:
            nuevo.sig = self.ultimo.sig
            self.ultimo.sig = nuevo
        self.ultimo = nuevo
        self.tam += 1

    def ordenar_seleccion(self, clave):       # Selección: O(n^2)
        """Ordena intercambiando datos; clave(dato) -> valor comparable."""
        if self.tam < 2:
            return
        actual = self.ultimo.sig
        for restantes in range(self.tam - 1, 0, -1):
            minimo = actual
            p = actual.sig
            for _ in range(restantes):
                if clave(p.dato) < clave(minimo.dato):
                    minimo = p
                p = p.sig
            actual.dato, minimo.dato = minimo.dato, actual.dato
            actual = actual.sig

    def round_robin(self, quantum):           # planificador de CPU
        """Cada elemento es una lista [nombre, restante]. Devuelve
        (bitácora de ejecución, tiempos de finalización)."""
        bitacora, fin = [], {}
        reloj = 0
        previo, actual = self.ultimo, self.ultimo.sig
        while self.tam > 0:
            proceso = actual.dato
            uso = min(quantum, proceso[1])
            proceso[1] -= uso
            reloj += uso
            bitacora.append((proceso[0], uso, reloj))
            if proceso[1] == 0:
                fin[proceso[0]] = reloj
                self.tam -= 1
                if self.tam == 0:
                    self.ultimo = None
                    break
                previo.sig = actual.sig
                if actual is self.ultimo:
                    self.ultimo = previo
                actual = previo.sig
            else:
                previo, actual = actual, actual.sig
        return bitacora, fin

    def josefo(self, k):                      # Problema de Josefo
        """Elimina cada k-ésimo elemento hasta quedar uno."""
        eliminados = []
        previo = self.ultimo
        while self.tam > 1:
            for _ in range(k - 1):
                previo = previo.sig
            victima = previo.sig
            eliminados.append(victima.dato)
            previo.sig = victima.sig
            self.tam -= 1
        self.ultimo = previo
        return eliminados, previo.sig.dato


# ======================================================================
# 4) LISTA CIRCULAR DOBLE (reproductor)
# ======================================================================
class ListaCircularDoble:
    def __init__(self):
        self.actual = None
        self.tam = 0

    def agregar(self, dato):                  # inserta antes de 'actual' (al final del ciclo)
        nuevo = NodoD(dato)
        if self.actual is None:
            nuevo.sig = nuevo.ant = nuevo
            self.actual = nuevo
        else:
            ultimo = self.actual.ant
            nuevo.sig, nuevo.ant = self.actual, ultimo
            ultimo.sig = nuevo
            self.actual.ant = nuevo
        self.tam += 1

    def siguiente(self):
        self.actual = self.actual.sig
        return self.actual.dato

    def anterior(self):
        self.actual = self.actual.ant
        return self.actual.dato

    def eliminar_actual(self):
        nodo = self.actual
        if self.tam == 1:
            self.actual = None
        else:
            nodo.ant.sig = nodo.sig
            nodo.sig.ant = nodo.ant
            self.actual = nodo.sig
        self.tam -= 1
        return nodo.dato


# ======================================================================
# Búsqueda binaria (sobre arreglo ordenado)
# ======================================================================
def busqueda_binaria(arreglo, folio):         # O(log n)
    bajo, alto, comparaciones = 0, len(arreglo) - 1, 0
    while bajo <= alto:
        medio = (bajo + alto) // 2
        comparaciones += 1
        if arreglo[medio].folio == folio:
            return medio, comparaciones
        if arreglo[medio].folio < folio:
            bajo = medio + 1
        else:
            alto = medio - 1
    return -1, comparaciones


