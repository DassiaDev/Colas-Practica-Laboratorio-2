def ejercicio_2():
    titulo("EJERCICIO 2 (Lista simple): Búsqueda lineal y cancelación")
    lista = ListaSimple()
    for o in datos_base():
        lista.insertar_final(o)
    orden, comps = lista.buscar(103)
    print(f"   Buscar folio 103 -> {orden} ({comps} comparaciones)")
    verificar(orden is not None and comps == 4, "folio 103 encontrado en 4 comparaciones")
    verificar(lista.buscar(777)[0] is None, "folio inexistente devuelve None")
    cancelada = lista.eliminar(108)
    verificar(cancelada.folio == 108 and len(lista) == 4, "se canceló la orden 108")
    lista.eliminar(105)  # cabeza
    verificar(lista.cabeza.dato.folio == 101, "eliminar la cabeza actualiza el inicio")


def ejercicio_3():
    titulo("EJERCICIO 3 (Lista simple): Ordenamiento por inserción e inversión")
    lista = ListaSimple()
    for o in datos_base():
        lista.insertar_final(o)
    lista.ordenar_insercion()
    folios = [o.folio for o in lista]
    print("   Orden por prioridad/folio:", folios)
