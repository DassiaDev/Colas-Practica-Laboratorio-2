    verificar(folios == [101, 105, 103, 110, 108], "lista invertida correctamente")


def ejercicio_4():
    titulo("EJERCICIO 4 (Lista simple): Fusión de dos sucursales ordenadas")
    a, b = ListaSimple(), ListaSimple()
    for o in [Orden(1, "A", "s", 1), Orden(4, "B", "s", 2), Orden(7, "C", "s", 3)]:
        a.insertar_final(o)
    for o in [Orden(2, "D", "s", 1), Orden(3, "E", "s", 2), Orden(9, "F", "s", 3)]:
        b.insertar_final(o)
    fusion = ListaSimple.fusionar_ordenadas(a, b)
    folios = [o.folio for o in fusion]
    print("   Fusión:", folios)
    verificar(folios == [1, 2, 3, 4, 7, 9], "fusión ordenada de 6 elementos")
    verificar(len(fusion) == 6 and len(a) == 3 and len(b) == 3, "las listas originales no cambian")


def ejercicio_5():
    titulo("EJERCICIO 5 (Lista doble): Historial de navegación atrás/adelante")

    class Historial(ListaDoble):
        def __init__(self):
            super().__init__()
            self.pos = None

        def visitar(self, url):
            if self.pos is not None:           # descarta el "adelante"
                self.pos.sig = None
                self.cola = self.pos
                n, p = 0, self.cabeza
                while p:
                    n, p = n + 1, p.sig
                self.tam = n
            self.insertar_final(url)
            self.pos = self.cola

        def atras(self):
            if self.pos and self.pos.ant:
                self.pos = self.pos.ant
            return self.pos.dato

        def adelante(self):
            if self.pos and self.pos.sig:
                self.pos = self.pos.sig
            return self.pos.dato

    h = Historial()
    for u in ["inicio", "ordenes", "clientes", "reportes"]:
        h.visitar(u)
    verificar(h.atras() == "clientes", "atrás -> clientes")
    verificar(h.atras() == "ordenes", "atrás -> ordenes")
    verificar(h.adelante() == "clientes", "adelante -> clientes")
    h.visitar("ajustes")  # borra 'reportes' del futuro
    print("   Historial final:", list(h))
    verificar(list(h) == ["inicio", "ordenes", "clientes", "ajustes"], "al visitar se borra el 'adelante'")


def ejercicio_6():
    titulo("EJERCICIO 6 (Lista doble): Inserción/eliminación por posición y recorrido inverso")
    ld = ListaDoble()
    for o in datos_base():
        ld.insertar_final(o)
    ld.insertar_en(2, Orden(200, "Nuevo", "Instalación", 2))
    print("   Directo :", [o.folio for o in ld])
    print("   Inverso :", [o.folio for o in ld.recorrer_inverso()])
    verificar([o.folio for o in ld][2] == 200, "inserción en posición 2")
    verificar([o.folio for o in ld.recorrer_inverso()] == [o.folio for o in ld][::-1],
              "el recorrido inverso es el reverso del directo")
    quitada = ld.eliminar_en(len(ld) - 1)
    verificar(quitada.folio == 110 and ld.cola.dato.folio == 103, "eliminar el último actualiza la cola")
    ld.eliminar_en(0)
    verificar(ld.cabeza.dato.folio == 101 and ld.cabeza.ant is None, "eliminar el primero actualiza la cabeza")
    try:
        ld.eliminar_en(50)
        verificar(False, "debió lanzar IndexError")
    except IndexError:
        verificar(True, "posición inválida lanza IndexError")


def ejercicio_7():
    titulo("EJERCICIO 7 (Lista doble): Burbuja + búsqueda binaria")
    ld = ListaDoble()
    for o in datos_base():
        ld.insertar_final(o)
    cambios = ld.ordenar_burbuja()
    print(f"   Orden: {[o.folio for o in ld]} ({cambios} intercambios)")
    verificar([o.folio for o in ld] == [108, 110, 103, 105, 101], "burbuja ordena por prioridad y folio")
    verificar(ld.ordenar_burbuja() == 0, "segunda pasada: 0 intercambios (mejor caso)")
    arreglo = sorted(ld, key=lambda o: o.folio)
    pos, comps = busqueda_binaria(arreglo, 108)
    print(f"   Búsqueda binaria del folio 108: índice {pos}, {comps} comparaciones")
    verificar(pos == 3 and comps <= 3, "binaria encuentra 108 en <= 3 comparaciones")
    verificar(busqueda_binaria(arreglo, 500)[0] == -1, "binaria devuelve -1 si no existe")


def ejercicio_8():
    titulo("EJERCICIO 8 (Lista circular): Selección + planificador Round Robin")
    c = ListaCircular()
    for nombre, t in [("P1", 5), ("P2", 3), ("P3", 8), ("P4", 2)]:
        c.insertar_final([nombre, t])
    c.ordenar_seleccion(clave=lambda p: p[1])
    print("   Procesos por duración:", [p[0] for p in c])
    verificar([p[0] for p in c] == ["P4", "P2", "P1", "P3"], "selección ordena por tiempo")
    bitacora, fin = c.round_robin(quantum=3)
    for nombre, uso, reloj in bitacora:
        print(f"   t={reloj:>2}: {nombre} usa {uso}")
    print("   Finalización:", fin)
    verificar(fin == {"P4": 2, "P2": 5, "P1": 13, "P3": 18},
              "tiempos de finalización: P4=2, P2=5, P1=13, P3=18")
    verificar(len(c) == 0, "la lista queda vacía al terminar")


def ejercicio_9():
    titulo("EJERCICIO 9 (Lista circular doble): Reproductor de música en bucle")
    r = ListaCircularDoble()
    for t in ["Tema A", "Tema B", "Tema C"]:
        r.agregar(t)
    verificar(r.actual.dato == "Tema A", "inicia en el primer tema")
    verificar([r.siguiente() for _ in range(4)] == ["Tema B", "Tema C", "Tema A", "Tema B"],
              "siguiente da la vuelta al llegar al final")
    verificar(r.anterior() == "Tema A" and r.anterior() == "Tema C", "anterior da la vuelta al inicio")
    eliminado = r.eliminar_actual()
    verificar(eliminado == "Tema C" and r.actual.dato == "Tema A" and r.tam == 2,
              "eliminar el tema actual avanza al siguiente")


def ejercicio_10():
    titulo("EJERCICIO 10 (Lista circular): Problema de Josefo (turnos de atención)")
    c = ListaCircular()
    for n in range(1, 8):
        c.insertar_final(n)
    eliminados, sobreviviente = c.josefo(3)
    print("   Eliminados:", eliminados, "| Sobreviviente:", sobreviviente)
    verificar(eliminados == [3, 6, 2, 7, 5, 1], "orden de eliminación correcto (n=7, k=3)")
    verificar(sobreviviente == 4, "el sobreviviente es el 4")
    c2 = ListaCircular()
    c2.insertar_final(1)
    verificar(c2.josefo(5) == ([], 1), "caso borde: un solo elemento")


