    ]


def ejercicio_1():
    titulo("EJERCICIO 1 (Lista simple): Alta y consulta de órdenes")
    lista = ListaSimple()
    for o in datos_base():
        lista.insertar_final(o)
    urgente = Orden(99, "Cliente VIP", "Reparación express", 1)
    lista.insertar_inicio(urgente)
    for o in lista:
        print("  ", o)
    verificar(len(lista) == 6, "la lista tiene 6 órdenes")
